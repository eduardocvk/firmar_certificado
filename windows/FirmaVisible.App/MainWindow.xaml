<Window x:Class="FirmaVisible.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FirmaVisible.App" Title="FirmaVisible · PDF con certificado" Width="1260" Height="840" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#172D47" Background="#F5F7FC" Closing="WindowClosing">
  <Grid Background="#F5F7FC">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel x:Name="Sidebar" Margin="22,22,16,12">
      <StackPanel DockPanel.Dock="Top" Margin="2,0,0,20"><TextBlock Text="FirmaVisible" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Tu certificado. Tu firma." Foreground="#66758E" Margin="0,5,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0"><CheckBox x:Name="TimestampCheck" Content="Sello de tiempo" IsChecked="True" Checked="TimestampChanged" Unchecked="TimestampChanged"/><TextBlock Text="DigiCert · requiere Internet · solo una huella" FontSize="10" Foreground="#66758E" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Content="Firmar y guardar copia  →" Click="SignClick" Background="#3155D9" Foreground="White" FontSize="14" Padding="12,14"/><Button x:Name="LastSignedButton" Visibility="Collapsed" Content="Abrir última copia firmada" Click="OpenSignedClick" IsEnabled="False" Background="Transparent" FontSize="11"/><Button Content="Código fuente y licencias" Click="AboutClick" Background="Transparent" FontSize="11" Padding="4"/></StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ActionsPanel" Margin="0,0,6,0">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01   DOCUMENTO" FontSize="10" FontWeight="Bold" Foreground="#66758E"/><TextBlock x:Name="DocumentLabel" Text="Abre el PDF que quieres firmar" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Abrir PDF…" Click="OpenPdfClick" Margin="0,4,6,4"/><Button Grid.Column="1" Content="Comprobar" Click="VerifyClick" Background="Transparent" FontSize="11"/></Grid></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02   CERTIFICADO" FontSize="10" FontWeight="Bold" Foreground="#66758E"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="De Windows…" Click="StoreClick" Margin="0,4,6,4" FontSize="12" Padding="8,10"/><Button Grid.Column="1" Content=".p12 / .pfx…" Click="ImportClick" FontSize="12" Padding="8,10"/></Grid><ComboBox x:Name="CertificateCombo" Margin="0,8,0,4" MinHeight="34" DisplayMemberPath="Description" SelectionChanged="CertificateChanged"/><WrapPanel><Button Content="Ver identidad" Click="IdentityClick" Margin="0,4,8,0" Padding="8,6" FontSize="11" Background="Transparent"/><Button Content="Olvidar" Click="ForgetClick" Padding="8,6" FontSize="11" Background="Transparent"/></WrapPanel></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="03   TU FIRMA VISIBLE" FontSize="10" FontWeight="Bold" Foreground="#66758E"/><TextBlock x:Name="DesignSummary" Text="Diseño guardado en este ordenador" FontSize="11" Foreground="#66758E" Margin="0,10,0,6"/><Button Content="Personalizar texto e imagen…" Click="CustomizeClick"/><Button Content="Colocar recuadro" Click="ResetBoxClick" Background="Transparent" FontSize="11"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
    <Grid Grid.Column="1" Margin="8,18,22,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12">
        <StackPanel x:Name="NavigationPanel" Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="‹" ToolTip="Página anterior" Click="PreviousClick" Width="42" FontSize="18"/><TextBlock x:Name="PageLabel" Text="Sin documento" VerticalAlignment="Center" Margin="12,0" FontSize="12"/><Button Content="›" ToolTip="Página siguiente" Click="NextClick" Width="42" FontSize="18"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ajustar" Click="FitClick" Margin="8,4"/><TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0" FontSize="11" Foreground="#66758E"/><Slider x:Name="ZoomSlider" Minimum="60" Maximum="240" Value="100" Width="120" VerticalAlignment="Center" ValueChanged="ZoomChanged"/></StackPanel>
      </DockPanel>
      <Border Grid.Row="1" Background="#E8EDF5" CornerRadius="16">
        <Grid>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 7,1 L 39,1 L 53,15 L 53,69 L 7,69 Z M 39,1 L 39,15 L 53,15 M 17,29 L 43,29 M 17,40 L 39,40 M 17,51 L 34,51" Stroke="#AAB8D1" StrokeThickness="2" Width="60" Height="72" HorizontalAlignment="Center" Margin="0,0,0,22"/><TextBlock Text="Tu documento, listo para firmar" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Abre un PDF y elige dónde colocar tu firma." Foreground="#66758E" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
          <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
            <Grid x:Name="PageSurface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" Visibility="Collapsed" MouseLeftButtonDown="SelectionDown" MouseMove="SelectionMove" MouseLeftButtonUp="SelectionUp" SizeChanged="SurfaceSizeChanged">
              <Grid.Effect><DropShadowEffect Color="#60718C" BlurRadius="18" Opacity="0.16" ShadowDepth="3"/></Grid.Effect>
              <Image x:Name="PageImage" Stretch="Fill"/>
              <Canvas x:Name="Overlay" ClipToBounds="True" Background="Transparent"><Border x:Name="SelectionBox" Visibility="Collapsed" BorderBrush="#3155D9" BorderThickness="1" IsHitTestVisible="False"><local:SignaturePreview x:Name="SelectedDesignPreview"/></Border><Ellipse x:Name="ResizeHandle" Visibility="Collapsed" Fill="#3155D9" Width="10" Height="10" IsHitTestVisible="False"/></Canvas>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
      <TextBlock Grid.Row="2" Text="Arrastra para colocar la firma · mueve el interior · ajusta la esquina inferior derecha" Foreground="#66758E" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" Padding="22,10"><DockPanel><ProgressBar x:Name="WorkingProgress" IsIndeterminate="True" Visibility="Collapsed" Width="70" Height="4" Margin="0,0,14,0" DockPanel.Dock="Left"/><TextBlock x:Name="StatusLabel" Text="Los documentos y las claves permanecen en tu ordenador." TextWrapping="Wrap" FontSize="11" Foreground="#66758E"/></DockPanel></Border>
  </Grid>
</Window>