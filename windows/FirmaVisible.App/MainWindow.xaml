<Window x:Class="FirmaVisible.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FirmaVisible.App" Title="FirmaPDF · PDF con certificado" Width="1260" Height="840" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#172D47" Background="#F5F7FC" Closing="WindowClosing" AllowDrop="True" PreviewDragOver="FilesDragOver" PreviewDrop="FilesDrop">
  <Grid Background="#F5F7FC">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel x:Name="Sidebar" Margin="22,22,16,12">
      <StackPanel DockPanel.Dock="Top" Margin="2,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="FirmaPDF" FontSize="29" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="SettingsButton" Grid.Column="1" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="21" Width="42" Height="42" Padding="8" Background="Transparent" ToolTip="Configuración" AutomationProperties.Name="Configuración" Click="SettingsClick"/></Grid></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><TextBlock x:Name="BatchSummary" Visibility="Collapsed"/><Button x:Name="SignAllButton" Content="Firmar" Click="SignClick" Background="#3155D9" Foreground="White" FontSize="16" Padding="12,14"/><Button x:Name="LastSignedButton" Visibility="Collapsed" Content="Abrir copia firmada" Click="OpenSignedClick" Background="Transparent" FontSize="11"/></StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ActionsPanel" Margin="0,0,6,0">
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01   DOCUMENTOS" FontSize="10" FontWeight="Bold" Foreground="#66758E"/><TextBlock x:Name="DocumentLabel" Visibility="Collapsed"/><ListBox x:Name="DocumentList" SelectionChanged="DocumentListChanged" MaxHeight="150" BorderThickness="0" Background="Transparent" Margin="0,8,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Header}" ToolTip="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" FontSize="12" Padding="3,5"/></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="Abrir archivos…" Click="OpenPdfClick" Margin="0,4,0,4"/><Button x:Name="VerifyButton" Content="Comprobar firmas" Click="VerifyClick" Visibility="Collapsed" Background="Transparent" FontSize="12"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02   CERTIFICADO" FontSize="10" FontWeight="Bold" Foreground="#66758E"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="De Windows…" Click="StoreClick" Margin="0,4,6,4" FontSize="12" Padding="8,10"/><Button Grid.Column="1" Content=".p12 / .pfx…" Click="ImportClick" FontSize="12" Padding="8,10"/></Grid><ComboBox x:Name="CertificateCombo" Margin="0,8,0,4" MinHeight="34" DisplayMemberPath="Description" SelectionChanged="CertificateChanged"/><WrapPanel><Button Content="Comprobar certificado" Click="IdentityClick" Margin="0,4,8,0" Padding="8,6" FontSize="11" Background="Transparent"/><Button Content="Olvidar" Click="ForgetClick" Padding="8,6" FontSize="11" Background="Transparent"/></WrapPanel></StackPanel></Border>
        <Border x:Name="SignatureCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="03   TU FIRMA VISIBLE" FontSize="10" FontWeight="Bold" Foreground="#66758E"/><ComboBox x:Name="SignatureCombo" DisplayMemberPath="Name" SelectionChanged="SignatureChanged" Margin="0,12,0,6"/><Border Padding="4" Height="54" Margin="0,4,0,6"><Viewbox Stretch="Uniform"><local:SignaturePreview x:Name="ProfilePreview" Width="320" Height="104"/></Viewbox></Border><TextBlock x:Name="DesignSummary" Visibility="Collapsed" FontSize="11" Foreground="#66758E" TextWrapping="Wrap" Margin="0,2,0,8"/><Button Content="Poner firma" Click="ResetBoxClick" Background="#3155D9" Foreground="White"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
    </DockPanel>
    <Grid x:Name="Workspace" Grid.Column="1" Margin="8,18,22,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl x:Name="DocumentTabs" SelectionChanged="DocumentTabChanged" Margin="0,0,0,10" BorderThickness="0" Background="Transparent" Visibility="Collapsed">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><TabPanel IsItemsHost="True"/></ScrollViewer></ControlTemplate></TabControl.Template>
        <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Background" Value="#E8EDF5"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabFrame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10,10,0,0" Padding="10,4"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFrame" Property="Background" Value="White"/><Setter TargetName="TabFrame" Property="BorderBrush" Value="#CAD6F2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.ItemContainerStyle>
        <TabControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" ToolTip="{Binding OriginalPath}"><TextBlock Text="{Binding Header}" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/><Button Content="×" Tag="{Binding}" Click="CloseTabClick" ToolTip="Cerrar PDF" AutomationProperties.Name="Cerrar PDF" Background="Transparent" FontSize="17" Padding="6,2" Margin="8,0,0,0"/></StackPanel></DataTemplate></TabControl.ItemTemplate>
      </TabControl>
      <StackPanel x:Name="ViewerToolbar" Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal" HorizontalAlignment="Right"><StackPanel x:Name="NavigationPanel" Orientation="Horizontal" Visibility="Collapsed"><Button Content="‹" ToolTip="Página anterior" Click="PreviousClick" Width="42" FontSize="18"/><TextBlock x:Name="PageLabel" Text="Sin documento" VerticalAlignment="Center" Margin="12,0" FontSize="12"/><Button Content="›" ToolTip="Página siguiente" Click="NextClick" Width="42" FontSize="18"/></StackPanel><Button Content="Ajustar" Click="FitClick" Margin="8,4"/><TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0" FontSize="11" Foreground="#66758E"/><Slider x:Name="ZoomSlider" Minimum="60" Maximum="240" Value="100" Width="120" VerticalAlignment="Center" ValueChanged="ZoomChanged"/></StackPanel>
      <Border Grid.Row="2" Background="#E8EDF5" CornerRadius="16"><Grid>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 7,1 L 39,1 L 53,15 L 53,69 L 7,69 Z M 39,1 L 39,15 L 53,15 M 17,29 L 43,29 M 17,40 L 39,40 M 17,51 L 34,51" Stroke="#AAB8D1" StrokeThickness="2" Width="60" Height="72" HorizontalAlignment="Center" Margin="0,0,0,22"/><TextBlock Text="Tus documentos, listos para firmar" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Arrastra archivos aquí o pulsa Abrir archivos." Foreground="#66758E" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
        <StackPanel x:Name="GenericState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="30"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="60" Foreground="#AAB8D1" HorizontalAlignment="Center" Margin="0,0,0,24"/><TextBlock x:Name="GenericName" TextWrapping="Wrap" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="GenericDescription" TextWrapping="Wrap" FontSize="14" Foreground="#66758E" TextAlignment="Center" Margin="0,16,0,0"/></StackPanel><ScrollViewer x:Name="Viewport" SizeChanged="ViewportSizeChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"><Grid x:Name="PageSurface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" Visibility="Collapsed" MouseLeftButtonDown="SelectionDown" MouseMove="SelectionMove" MouseLeftButtonUp="SelectionUp" SizeChanged="SurfaceSizeChanged"><Grid.Effect><DropShadowEffect Color="#60718C" BlurRadius="18" Opacity="0.16" ShadowDepth="3"/></Grid.Effect><Image x:Name="PageImage" Stretch="Fill"/><Canvas x:Name="Overlay" ClipToBounds="True" Background="Transparent"><Border x:Name="SelectionBox" Visibility="Collapsed" BorderBrush="#3155D9" BorderThickness="1" IsHitTestVisible="False"><local:SignaturePreview x:Name="SelectedDesignPreview"/></Border><Ellipse x:Name="ResizeHandle" Visibility="Collapsed" Fill="#3155D9" Width="10" Height="10" IsHitTestVisible="False"/></Canvas></Grid><Grid x:Name="SecondPageSurface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" Margin="24,0,0,0" Visibility="Collapsed" MouseLeftButtonDown="SelectionDown" MouseMove="SelectionMove" MouseLeftButtonUp="SelectionUp" SizeChanged="SurfaceSizeChanged"><Grid.Effect><DropShadowEffect Color="#60718C" BlurRadius="18" Opacity="0.16" ShadowDepth="3"/></Grid.Effect><Image x:Name="SecondPageImage" Stretch="Fill"/><Canvas x:Name="SecondOverlay" ClipToBounds="True" Background="Transparent"><Border x:Name="SecondSelectionBox" Visibility="Collapsed" BorderBrush="#3155D9" BorderThickness="1" IsHitTestVisible="False"><local:SignaturePreview x:Name="SecondDesignPreview"/></Border><Ellipse x:Name="SecondResizeHandle" Visibility="Collapsed" Fill="#3155D9" Width="10" Height="10" IsHitTestVisible="False"/></Canvas></Grid></StackPanel></ScrollViewer>
      </Grid></Border>
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" Padding="22,10"><DockPanel><ProgressBar x:Name="WorkingProgress" IsIndeterminate="True" Visibility="Collapsed" Width="70" Height="4" Margin="0,0,14,0" DockPanel.Dock="Left"/><TextBlock x:Name="StatusLabel" Text="Los documentos y las claves permanecen en tu ordenador." TextWrapping="Wrap" FontSize="11" Foreground="#66758E"/></DockPanel></Border>
  </Grid>
</Window>
