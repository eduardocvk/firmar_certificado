<Window x:Class="FirmaVisible.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FirmaVisible · PDF con certificado" Width="1220" Height="850" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#18314F" Background="#F3F6FA" Closing="WindowClosing">
  <Grid Background="#F3F6FA">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="315"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="White" Padding="24,24,20,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ActionsPanel">
          <TextBlock Text="FirmaVisible" FontSize="29" FontWeight="SemiBold"/>
          <TextBlock Text="PDF firmado en tu ordenador" Margin="0,5,0,22" Foreground="#597089"/>
          <TextBlock Text="1. DOCUMENTO" FontSize="11" FontWeight="Bold"/>
          <Button Content="Abrir PDF…" Click="OpenPdfClick"/>
          <TextBlock x:Name="DocumentLabel" Text="Sin documento" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,18"/>
          <TextBlock Text="2. CERTIFICADO" FontSize="11" FontWeight="Bold"/>
          <Button Content="Certificados de Windows…" Click="StoreClick"/>
          <Button Content="Abrir .p12 / .pfx…" Click="ImportClick"/>
          <ComboBox x:Name="CertificateCombo" Margin="0,6" MinHeight="34" DisplayMemberPath="Description" SelectionChanged="CertificateChanged"/>
          <WrapPanel><Button Content="Ver identidad" Click="IdentityClick" Margin="0,4,8,4"/><Button Content="Olvidar" Click="ForgetClick"/></WrapPanel>
          <TextBlock Text="3. FIRMA VISIBLE" FontSize="11" FontWeight="Bold" Margin="0,18,0,8"/>
          <TextBlock Text="Arrastra sobre la página para dibujar el recuadro. Mueve su interior o ajusta su esquina inferior derecha." TextWrapping="Wrap" FontSize="12"/>
          <Button Content="Colocar recuadro" Click="ResetBoxClick"/>
          <Button Content="Firmar y guardar copia…" Click="SignClick" Background="#1E4F88" Foreground="White" FontWeight="SemiBold" Margin="0,18,0,4"/>
          <Button Content="Comprobar firmas" Click="VerifyClick"/>
          <TextBlock Text="Sin sello de tiempo. La comprobación de integridad no comprueba confianza ni revocación." TextWrapping="Wrap" FontSize="11" Foreground="#597089" Margin="0,18,0,8"/>
          <Button Content="Código fuente y licencias" Click="AboutClick" Background="Transparent" BorderThickness="0" FontSize="11"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Column="1" Margin="16,12,16,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <StackPanel x:Name="NavigationPanel" Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="←" ToolTip="Página anterior" Click="PreviousClick" Width="40"/>
          <TextBlock x:Name="PageLabel" Text="Sin documento" VerticalAlignment="Center" Margin="12,0"/>
          <Button Content="→" ToolTip="Página siguiente" Click="NextClick" Width="40"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Zoom" VerticalAlignment="Center" Margin="10,0"/><Slider x:Name="ZoomSlider" Minimum="60" Maximum="220" Value="100" Width="130" VerticalAlignment="Center" ValueChanged="ZoomChanged"/></StackPanel>
      </DockPanel>
      <ScrollViewer x:Name="Viewport" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#DFE7F0" Padding="16">
        <Grid x:Name="PageSurface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" Visibility="Collapsed" MouseLeftButtonDown="SelectionDown" MouseMove="SelectionMove" MouseLeftButtonUp="SelectionUp" SizeChanged="SurfaceSizeChanged">
          <Image x:Name="PageImage" Stretch="Fill"/>
          <Canvas x:Name="Overlay" ClipToBounds="True" Background="Transparent">
            <Border x:Name="SelectionBox" Visibility="Collapsed" BorderBrush="#285396" BorderThickness="1.5" Background="#EDF4FF" Opacity="0.93" Padding="6" IsHitTestVisible="False">
              <StackPanel><TextBlock Text="Firmado digitalmente" FontSize="11"/><TextBlock x:Name="SignerPreview" Text="Selecciona un certificado" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="Fecha y hora del dispositivo" FontSize="10" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Rectangle x:Name="ResizeHandle" Visibility="Collapsed" Fill="#285396" Width="12" Height="12" IsHitTestVisible="False"/>
          </Canvas>
        </Grid>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" Padding="20,10"><TextBlock x:Name="StatusLabel" Text="Abre un PDF para empezar." TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
