<Window x:Class="FirmaVisible.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FirmaVisible.App" Title="Configuración · FirmaPDF" Width="820" Height="810" MinWidth="650" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F5F7FC" Foreground="#172D47" FontFamily="Segoe UI">
  <Grid Background="#F5F7FC"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="Configuración" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Tus firmas y preferencias, guardadas en este ordenador." Foreground="#66758E" Margin="0,5,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Firmas personalizadas" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Crea varios diseños de texto e imagen y elige uno para cada PDF desde la pantalla principal." TextWrapping="Wrap" Foreground="#66758E" FontSize="12" Margin="0,8,0,12"/>
        <ListBox x:Name="PresetList" Height="105" DisplayMemberPath="Name" SelectionChanged="PresetChanged"/>
        <Grid Margin="0,10,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NameText" MaxLength="60" Padding="8" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Cambiar nombre" Click="RenamePreset" Margin="8,0,0,0"/></Grid>
        <WrapPanel><Button Content="Nueva firma" Click="CreatePreset" Margin="0,4,8,4"/><Button Content="Personalizar texto e imagen…" Click="EditPreset" Margin="0,4,8,4"/><Button Content="Eliminar" Click="DeletePreset" Background="Transparent"/></WrapPanel>
        <Border Background="White" Padding="10" Margin="0,8,0,0"><Viewbox Stretch="Uniform" MaxHeight="120"><local:SignaturePreview x:Name="PresetPreview" Width="320" Height="104"/></Viewbox></Border>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Opciones de firma" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="ConfirmBeforeCheck" Content="Confirmar antes de firmar el lote" Margin="0,12,0,10"/><CheckBox x:Name="SuccessDialogCheck" Content="Mostrar aviso al terminar" Margin="0,0,0,12"/><CheckBox x:Name="TimestampCheck" Content="Sello de tiempo"/><TextBlock Text="DigiCert · requiere Internet; se envía solo una huella de cada firma. Si falla, no se guardan copias sin el sello solicitado." FontSize="11" TextWrapping="Wrap" Foreground="#66758E" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows y aplicación" FontSize="17" FontWeight="SemiBold"/><Button Content="Menú del botón derecho…" Click="ExplorerClick" HorizontalAlignment="Left" Margin="0,12,0,4"/><Button Content="Código fuente y licencias" Click="AboutClick" Background="Transparent" HorizontalAlignment="Left"/><TextBlock Text="Las copias se guardan junto a los originales con el sufijo _firmado. Los originales no se modifican y nunca se reemplaza una copia existente." TextWrapping="Wrap" FontSize="11" Foreground="#66758E" Margin="0,8,0,0"/></StackPanel></Border>
      <Button Content="Privacidad" Click="PrivacyClick" HorizontalAlignment="Left" Background="Transparent" Margin="0,0,0,10"/>
      <TextBlock x:Name="ValidationText" Foreground="#A13B30" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancelar" IsCancel="True" MinWidth="100" Margin="0,0,10,0"/><Button Content="Guardar configuración" Click="SaveSettings" IsDefault="True" Background="#3155D9" Foreground="White"/></StackPanel>
  </Grid></Grid>
</Window>
