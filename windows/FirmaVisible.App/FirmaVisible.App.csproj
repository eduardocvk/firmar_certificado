<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FirmaVisible</AssemblyName>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Store/Assets/App.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../FirmaVisible.Core/FirmaVisible.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Resource Include="../../pdf/src/main/resources/fonts/NotoSans-Regular.ttf" Link="Resources/NotoSans-Regular.ttf" />
    <Content Include="../../pdf/src/main/resources/fonts/OFL.txt" Link="licenses/NotoSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../core/src/main/resources/tsa/README.txt" Link="licenses/TSA-README.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD_PARTY.txt" Link="THIRD_PARTY.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ITEXT-LICENSE.md" Link="ITEXT-LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
